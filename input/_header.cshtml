@{
  var headerImage = Document.GetString("HeaderImage") ?? "/images/corvette-banner.jpg";
  var title = Document.GetString("BannerTitle") ?? Document.GetString("Title");
  var subTitle = Document.GetString("SiteTitle");
}
<header class="masthead" style='background-image: url("@headerImage")'>
  <div class="container position-relative px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        <div class="site-heading">
          <span class="subheading">@title</span>
        </div>
      </div>
    </div>
  </div>
</header>